{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chengzi-io.github.io/skills/dependencies.schema.json",
  "title": "Plugin Dependency Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "dependencies"],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "type": "integer",
      "const": 2
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/source"
      }
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repo", "items"],
      "description": "One upstream repo at a single ref (branch/tag/release); all items under it share one resolved pin.",
      "properties": {
        "repo": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+\\/[A-Za-z0-9_.-]+$"
        },
        "branch": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string",
          "minLength": 1
        },
        "release": {
          "type": "string",
          "minLength": 1
        },
        "resolved": {
          "$ref": "#/$defs/resolved"
        },
        "items": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/item"
          }
        }
      },
      "oneOf": [
        { "required": ["branch"] },
        { "required": ["tag"] },
        { "required": ["release"] },
        {
          "not": {
            "anyOf": [
              { "required": ["branch"] },
              { "required": ["tag"] },
              { "required": ["release"] }
            ]
          }
        }
      ]
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "path", "target"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["skill", "agent"]
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "target": {
          "$ref": "#/$defs/target"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "type": { "const": "skill" } },
            "required": ["type"]
          },
          "then": {
            "properties": {
              "path": {
                "type": "string",
                "pattern": "^.+(?:\\/SKILL\\.md)?$"
              }
            }
          }
        },
        {
          "if": {
            "properties": { "type": { "const": "agent" } },
            "required": ["type"]
          },
          "then": {
            "properties": {
              "path": {
                "type": "string",
                "pattern": "^.+\\.md$"
              }
            }
          }
        }
      ]
    },
    "resolved": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sha", "syncedAt"],
      "description": "Pinned commit actually present on disk after last successful install/sync.",
      "properties": {
        "sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$",
          "description": "Full Git commit SHA of the upstream ref when content was written to disk."
        },
        "syncedAt": {
          "type": "string",
          "minLength": 1,
          "description": "ISO-8601 timestamp of the last successful install/sync that produced this SHA."
        }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["plugin"],
      "properties": {
        "plugin": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
        },
        "name": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
        }
      }
    }
  }
}
